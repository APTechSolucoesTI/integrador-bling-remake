generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TenantRole {
  owner
  admin
  operator
  viewer
}

enum IntegrationKind {
  bling
  apchat
  mercado_livre
}

enum JobExecutionStatus {
  queued
  active
  completed
  failed
  cancelled
}

model Tenant {
  id            String              @id @default(uuid()) @db.Uuid
  legacyUnitId  Int?                @unique @map("legacy_unit_id")
  name          String
  slug          String              @unique
  demo          Boolean             @default(false)
  active        Boolean             @default(true)
  brandName     String?             @map("brand_name")
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships   TenantMembership[]
  integrations  IntegrationConfig[]
  featureFlags  FeatureFlag[]
  auditLogs     AuditLog[]
  jobExecutions JobExecution[]
  authSessions  AuthSession[]

  @@map("saas_tenant")
}

model User {
  id           String             @id @default(uuid()) @db.Uuid
  email        String             @unique
  name         String
  passwordHash String             @map("password_hash")
  active       Boolean            @default(true)
  superAdmin   Boolean            @default(false) @map("super_admin")
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships  TenantMembership[]
  authSessions AuthSession[]

  @@map("saas_user")
}

model TenantMembership {
  tenantId     String     @map("tenant_id") @db.Uuid
  legacyUserId Int        @map("legacy_user_id")
  userId       String?    @map("user_id") @db.Uuid
  role         TenantRole
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user         User?      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([tenantId, legacyUserId])
  @@unique([tenantId, userId])
  @@index([legacyUserId])
  @@index([userId])
  @@map("saas_tenant_membership")
}

model AuthSession {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  userId         String    @map("user_id") @db.Uuid
  activeTenantId String    @map("active_tenant_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant   Tenant    @relation(fields: [activeTenantId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([activeTenantId, expiresAt])
  @@map("saas_auth_session")
}

model IntegrationConfig {
  id                   String          @id @default(uuid()) @db.Uuid
  tenantId             String          @map("tenant_id") @db.Uuid
  kind                 IntegrationKind
  enabled              Boolean         @default(false)
  fake                 Boolean         @default(false)
  credentialCiphertext Bytes?          @map("credential_ciphertext")
  metadata             Json            @default("{}")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, kind])
  @@map("saas_integration_config")
}

model FeatureFlag {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, key])
  @@map("saas_feature_flag")
}

model AuditLog {
  id            BigInt   @id @default(autoincrement())
  tenantId      String   @map("tenant_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  correlationId String   @map("correlation_id") @db.Uuid
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@map("saas_audit_log")
}

model JobExecution {
  id            String             @id @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  jobType       String             @map("job_type")
  status        JobExecutionStatus
  attempt       Int                @default(0)
  correlationId String             @map("correlation_id") @db.Uuid
  startedAt     DateTime?          @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?          @map("finished_at") @db.Timestamptz(3)
  errorCode     String?            @map("error_code")
  errorMessage  String?            @map("error_message")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@map("saas_job_execution")
}
