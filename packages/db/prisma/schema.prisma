generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum IntegrationKind {
  bling
  apchat
  mercado_livre
}

enum OAuthStatus {
  disconnected
  pending
  connected
  expired
  error
}

enum JobExecutionStatus {
  queued
  active
  completed
  failed
  cancelled
}

enum CalculationStatus {
  pending
  calculated
  inconsistent
  failed
}

enum MessageStatus {
  pending
  sent
  failed
  skipped
}

enum GoalStatus {
  open
  completed
  cancelled
}

enum CostApplication {
  Item
  Nota
}

enum CostValueType {
  F
  P
}

enum ImportStatus {
  pending
  running
  completed
  failed
}

model Tenant {
  id                    String                 @id @default(uuid()) @db.Uuid
  legacyUnitId          Int?                   @unique @map("legacy_unit_id")
  name                  String
  slug                  String                 @unique
  demo                  Boolean                @default(false)
  active                Boolean                @default(true)
  brandName             String?                @map("brand_name")
  taxRegime             String?                @map("tax_regime")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships           TenantMembership[]
  accessProfiles        AccessProfile[]
  integrations          IntegrationConfig[]
  oauthCredentials      OAuthCredential[]
  integrationRateLimits IntegrationRateLimit[]
  apChatConfigs         ApChatConfig[]
  featureFlags          FeatureFlag[]
  auditLogs             AuditLog[]
  jobExecutions         JobExecution[]
  authSessions          AuthSession[]
  products              Product[]
  productGroups         ProductGroup[]
  contacts              Contact[]
  sectors               Sector[]
  sellers               Seller[]
  salesChannels         SalesChannel[]
  paymentMethods        PaymentMethod[]
  operationNatures      OperationNature[]
  salesOrders           SalesOrder[]
  invoices              Invoice[]
  fixedCostCategories   FixedCostCategory[]
  fixedCosts            FixedCost[]
  ncmCredits            NcmCredit[]
  taxRules              TaxRule[]
  difalRules            DifalRule[]
  installmentFees       InstallmentFee[]
  satisfactionConfigs   SatisfactionConfig[]
  schedules             OperationalSchedule[]
  nfeSyncPolicy         NfeSyncPolicy?
  operationalLogs       OperationalLog[]
  notifications         SystemNotification[]
  goals                 Goal[]
  importRuns            LegacyImportRun[]
  legacyMappings        LegacyEntityMapping[]

  @@map("saas_tenant")
}

model User {
  id                String             @id @default(uuid()) @db.Uuid
  legacyId          Int?               @unique @map("legacy_id")
  email             String             @unique
  name              String
  passwordHash      String             @map("password_hash")
  active            Boolean            @default(true)
  superAdmin        Boolean            @default(false) @map("super_admin")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  memberships       TenantMembership[]
  authSessions      AuthSession[]
  preferences       UserPreference[]
  notificationReads NotificationRead[]

  @@map("saas_user")
}

model TenantMembership {
  id              String        @id @default(uuid()) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  legacyUserId    Int?          @map("legacy_user_id")
  accessProfileId String        @map("access_profile_id") @db.Uuid
  active          Boolean       @default(true)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user            User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  accessProfile   AccessProfile @relation(fields: [accessProfileId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@unique([tenantId, legacyUserId])
  @@index([userId])
  @@index([tenantId, accessProfileId])
  @@map("saas_tenant_membership")
}

model AccessProfile {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  name        String
  description String?
  permissions String[]           @default([])
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  memberships TenantMembership[]

  @@unique([tenantId, name])
  @@index([tenantId, name])
  @@map("saas_access_profile")
}

model UserPreference {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tenantId  String   @map("tenant_id") @db.Uuid
  zoom      Int      @default(100)
  fixedMenu Boolean  @default(true) @map("fixed_menu")
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([userId])
  @@map("saas_user_preference")
}

model AuthSession {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(64)
  userId         String    @map("user_id") @db.Uuid
  activeTenantId String    @map("active_tenant_id") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  masterKeyAccess Boolean  @default(false) @map("master_key_access")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeTenant   Tenant    @relation(fields: [activeTenantId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([activeTenantId, expiresAt])
  @@map("saas_auth_session")
}

model IntegrationConfig {
  id                   String          @id @default(uuid()) @db.Uuid
  tenantId             String          @map("tenant_id") @db.Uuid
  kind                 IntegrationKind
  enabled              Boolean         @default(false)
  fake                 Boolean         @default(false)
  credentialCiphertext Bytes?          @map("credential_ciphertext")
  metadata             Json            @default("{}")
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant               Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, kind])
  @@map("integration_config")
}

model OAuthCredential {
  id                     String          @id @default(uuid()) @db.Uuid
  tenantId               String          @map("tenant_id") @db.Uuid
  kind                   IntegrationKind
  status                 OAuthStatus     @default(disconnected)
  clientIdCiphertext     Bytes?          @map("client_id_ciphertext")
  clientSecretCiphertext Bytes?          @map("client_secret_ciphertext")
  accessTokenCiphertext  Bytes?          @map("access_token_ciphertext")
  refreshTokenCiphertext Bytes?          @map("refresh_token_ciphertext")
  accessTokenExpiresAt   DateTime?       @map("access_token_expires_at") @db.Timestamptz(3)
  authorizationStateHash String?         @map("authorization_state_hash") @db.VarChar(64)
  authorizationExpiresAt DateTime?       @map("authorization_expires_at") @db.Timestamptz(3)
  connectedAt            DateTime?       @map("connected_at") @db.Timestamptz(3)
  lastError              String?         @map("last_error")
  metadata               Json            @default("{}")
  createdAt              DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                 Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, kind])
  @@index([kind, status])
  @@map("oauth_credential")
}

model IntegrationRateLimit {
  tenantId        String          @map("tenant_id") @db.Uuid
  kind            IntegrationKind
  nextAvailableAt DateTime        @default(now()) @map("next_available_at") @db.Timestamptz(3)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant          @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, kind])
  @@map("integration_rate_limit")
}

model ApChatConfig {
  id                    String   @id @default(uuid()) @db.Uuid
  tenantId              String   @map("tenant_id") @db.Uuid
  enabled               Boolean  @default(false)
  workspaceIdCiphertext Bytes?   @map("workspace_id_ciphertext")
  tokenCiphertext       Bytes?   @map("token_ciphertext")
  invoicePhone          String?  @map("invoice_phone") @db.VarChar(20)
  reportPhone           String?  @map("report_phone") @db.VarChar(20)
  testPhone             String?  @map("test_phone") @db.VarChar(20)
  sendMessages          Boolean  @default(false) @map("send_messages")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant                Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId])
  @@map("apchat_config")
}

model FeatureFlag {
  tenantId  String   @map("tenant_id") @db.Uuid
  key       String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@id([tenantId, key])
  @@map("saas_feature_flag")
}

model AuditLog {
  id            BigInt   @id @default(autoincrement())
  tenantId      String   @map("tenant_id") @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  action        String
  entityType    String   @map("entity_type")
  entityId      String?  @map("entity_id")
  correlationId String   @map("correlation_id") @db.Uuid
  metadata      Json     @default("{}")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("saas_audit_log")
}

model JobExecution {
  id            String             @id @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  jobType       String             @map("job_type")
  status        JobExecutionStatus
  attempt       Int                @default(0)
  correlationId String             @map("correlation_id") @db.Uuid
  payload       Json               @default("{}")
  result        Json?
  startedAt     DateTime?          @map("started_at") @db.Timestamptz(3)
  finishedAt    DateTime?          @map("finished_at") @db.Timestamptz(3)
  errorCode     String?            @map("error_code")
  errorMessage  String?            @map("error_message")
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([tenantId, createdAt])
  @@index([status, createdAt])
  @@index([correlationId])
  @@map("saas_job_execution")
}

model SystemNotification {
  id         String             @id @default(uuid()) @db.Uuid
  tenantId   String             @map("tenant_id") @db.Uuid
  sourceKey  String             @map("source_key")
  kind       String
  level      String             @default("info")
  title      String
  message    String
  detail     Json               @default("{}")
  actionHref String?            @map("action_href")
  permission String?
  occurredAt DateTime           @map("occurred_at") @db.Timestamptz(3)
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  reads      NotificationRead[]

  @@unique([tenantId, sourceKey])
  @@index([tenantId, occurredAt])
  @@map("system_notification")
}

model NotificationRead {
  notificationId String             @map("notification_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  readAt         DateTime           @default(now()) @map("read_at") @db.Timestamptz(3)
  notification   SystemNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt])
  @@map("system_notification_read")
}

model ProductGroup {
  id              Int       @id @default(autoincrement())
  tenantId        String    @map("unit_id") @db.Uuid
  legacyId        Int?      @map("legacy_id")
  externalBlingId String?   @map("id_bling")
  name            String    @map("nome")
  ownManufacture  Boolean   @default(false) @map("own_manufacture")
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  products        Product[]

  @@unique([tenantId, legacyId])
  @@unique([tenantId, externalBlingId])
  @@index([tenantId, name])
  @@map("grupo_produto")
}

model Product {
  id                 Int           @id @default(autoincrement())
  tenantId           String        @map("unit_id") @db.Uuid
  legacyId           Int?          @map("legacy_id")
  externalBlingId    String        @map("id_produto")
  groupId            Int?          @map("group_id")
  sku                String?       @map("codigo")
  name               String        @map("nome")
  description        String?       @map("descricao")
  ncm                String?       @db.VarChar(8)
  cost               Decimal       @default(0) @map("custo") @db.Decimal(18, 4)
  active             Boolean       @default(true)
  ownManufacture     Boolean       @default(false) @map("fabricacao_propria")
  monophase          Boolean       @default(false)
  lastSynchronizedAt DateTime?     @map("ultima_atualizacao_bling") @db.Timestamptz(3)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  group              ProductGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  invoiceItems       InvoiceItem[]

  @@unique([tenantId, legacyId])
  @@unique([tenantId, externalBlingId])
  @@index([tenantId, sku])
  @@index([tenantId, name])
  @@index([tenantId, ncm])
  @@map("produtos")
}

model Contact {
  id                   Int                    @id @default(autoincrement())
  tenantId             String                 @map("unit_id") @db.Uuid
  legacyId             Int?                   @map("legacy_id")
  externalBlingId      String                 @map("id_bling")
  name                 String                 @map("nome")
  documentNumber       String?                @map("numero_documento")
  stateRegistration    String?                @map("ie")
  identityDocument     String?                @map("rg")
  phone                String?                @map("telefone")
  contactPhone         String?                @map("telefone_contato")
  mobilePhone          String?                @map("celular")
  email                String?
  messagingDisabled    Boolean                @default(false) @map("desabilitar_envio")
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant               Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  addresses            ContactAddress[]
  invoices             Invoice[]
  satisfactionDispatch SatisfactionDispatch[]

  @@unique([tenantId, legacyId])
  @@unique([tenantId, externalBlingId])
  @@index([tenantId, name])
  @@index([tenantId, documentNumber])
  @@map("pessoa")
}

model ContactAddress {
  id         Int      @id @default(autoincrement())
  tenantId   String   @map("unit_id") @db.Uuid
  contactId  Int      @map("pessoa_id")
  legacyId   Int?     @map("legacy_id")
  label      String?
  street     String?  @map("endereco")
  number     String?  @map("numero")
  complement String?  @map("complemento")
  district   String?  @map("bairro")
  postalCode String?  @map("cep") @db.VarChar(12)
  city       String?  @map("municipio")
  state      String?  @map("uf") @db.VarChar(2)
  country    String?  @db.VarChar(2)
  primary    Boolean  @default(false)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  contact    Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([tenantId, legacyId])
  @@index([tenantId, contactId])
  @@map("pessoa_endereco")
}

model Sector {
  id        Int          @id @default(autoincrement())
  tenantId  String       @map("unit_id") @db.Uuid
  legacyId  Int?         @map("legacy_id")
  name      String       @map("nome")
  active    Boolean      @default(true)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sellers   Seller[]
  goalItems GoalSector[]

  @@unique([tenantId, legacyId])
  @@unique([tenantId, name])
  @@map("setor")
}

model Seller {
  id              Int          @id @default(autoincrement())
  tenantId        String       @map("unit_id") @db.Uuid
  legacyId        Int?         @map("legacy_id")
  externalBlingId String?      @map("id_bling")
  sectorId        Int?         @map("sector_id")
  name            String       @map("nome")
  active          Boolean      @default(true)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sector          Sector?      @relation(fields: [sectorId], references: [id], onDelete: SetNull)
  invoices        Invoice[]
  goalItems       GoalSeller[]

  @@unique([tenantId, legacyId])
  @@unique([tenantId, externalBlingId])
  @@index([tenantId, name])
  @@index([tenantId, sectorId])
  @@map("vendedores")
}

model SalesChannel {
  id              Int                @id @default(autoincrement())
  tenantId        String             @map("unit_id") @db.Uuid
  legacyId        Int?               @map("legacy_id")
  externalBlingId String?            @map("loja_id")
  description     String             @map("descricao")
  type            String?            @map("tipo")
  active          Boolean            @default(true)
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoices        Invoice[]
  fixedCosts      FixedCostChannel[]

  @@unique([tenantId, legacyId])
  @@unique([tenantId, externalBlingId])
  @@index([tenantId, description])
  @@map("canal_venda")
}

model PaymentMethod {
  id              Int       @id @default(autoincrement())
  tenantId        String    @map("unit_id") @db.Uuid
  legacyId        Int?      @map("legacy_id")
  externalBlingId String    @map("id_bling")
  description     String    @map("descricao")
  paymentType     String?   @map("tipo_pagamento")
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoices        Invoice[]

  @@unique([tenantId, legacyId])
  @@unique([tenantId, externalBlingId])
  @@index([tenantId, description])
  @@map("forma_pagamento")
}

model OperationNature {
  id              Int       @id @default(autoincrement())
  tenantId        String    @map("unit_id") @db.Uuid
  legacyId        Int?      @map("legacy_id")
  externalBlingId String    @map("id_bling")
  description     String    @map("descricao")
  active          Boolean   @default(true)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  invoices        Invoice[]

  @@unique([tenantId, legacyId])
  @@unique([tenantId, externalBlingId])
  @@index([tenantId, description])
  @@map("natureza_operacao")
}

model SalesOrder {
  id                 Int       @id @default(autoincrement())
  tenantId           String    @map("unit_id") @db.Uuid
  legacyId           Int?      @map("legacy_id")
  externalBlingId    String    @map("id_bling")
  number             Int?      @map("numero")
  issuedAt           DateTime? @map("data") @db.Date
  total              Decimal   @default(0) @db.Decimal(18, 4)
  statusCode         Int?      @map("situacao")
  discount           Decimal   @default(0) @map("desconto") @db.Decimal(18, 4)
  invoiceExternalId  String?   @map("nfe_id_bling")
  commissionRate     Decimal   @default(0) @map("taxa_comissao") @db.Decimal(9, 4)
  shippingCost       Decimal   @default(0) @map("custo_frete") @db.Decimal(18, 4)
  lastSynchronizedAt DateTime? @map("ultima_att") @db.Timestamptz(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, legacyId])
  @@unique([tenantId, externalBlingId])
  @@index([tenantId, issuedAt])
  @@index([tenantId, invoiceExternalId])
  @@map("pedido_venda")
}

model Invoice {
  id                        Int                    @id @default(autoincrement())
  tenantId                  String                 @map("unit_id") @db.Uuid
  legacyId                  Int?                   @map("legacy_id")
  externalBlingId           String                 @map("id_bling")
  contactId                 Int?                   @map("contact_id")
  sellerId                  Int?                   @map("seller_id")
  salesChannelId            Int?                   @map("sales_channel_id")
  paymentMethodId           Int?                   @map("payment_method_id")
  operationNatureId         Int?                   @map("operation_nature_id")
  contactExternalId         String?                @map("contato_id_bling")
  sellerExternalId          String?                @map("vendedor_id")
  salesChannelExternalId    String?                @map("loja_id")
  operationNatureExternalId String?                @map("natureza_operacao_id")
  direction                 Int?                   @map("tipo")
  statusCode                Int                    @map("situacao")
  number                    String                 @map("numero")
  series                    Int?                   @map("serie")
  accessKey                 String?                @map("chave_acesso")
  issuedAt                  DateTime?              @map("data_emissao") @db.Timestamptz(3)
