  goal           Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  seller         Seller   @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  @@unique([goalId, sellerId])
  @@index([sellerId])
  @@map("meta_vendedores")
}

model GoalSector {
  id             Int      @id @default(autoincrement())
  goalId         Int      @map("meta_id")
  sectorId       Int      @map("setor_id")
  targetValue    Decimal  @map("valor_meta") @db.Decimal(18, 4)
  commissionType String?  @map("tipo_comissao") @db.VarChar(1)
  commission     Decimal? @map("comissao") @db.Decimal(9, 4)
  goal           Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  sector         Sector   @relation(fields: [sectorId], references: [id], onDelete: Restrict)

  @@unique([goalId, sectorId])
  @@index([sectorId])
  @@map("meta_setor")
}

model GoalCost {
  id          Int     @id @default(autoincrement())
  goalId      Int     @map("meta_id")
  description String?
  value       Decimal @map("valor_custo") @db.Decimal(18, 4)
  goal        Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("meta_custo")
}

model LegacyImportRun {
  id                String       @id @default(uuid()) @db.Uuid
  tenantId          String?      @map("tenant_id") @db.Uuid
  status            ImportStatus @default(pending)
  sourceFingerprint String?      @map("source_fingerprint")
  startedAt         DateTime?    @map("started_at") @db.Timestamptz(3)
  finishedAt        DateTime?    @map("finished_at") @db.Timestamptz(3)
  checkpoints       Json         @default("{}")
  statistics        Json         @default("{}")
  errorMessage      String?      @map("error_message")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant            Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([tenantId, createdAt])
  @@map("legacy_import_run")
}

model LegacyEntityMapping {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @map("tenant_id") @db.Uuid
  entityType String   @map("entity_type")
  legacyId   String   @map("legacy_id")
  modernId   String   @map("modern_id") @db.Uuid
  sourceHash String?  @map("source_hash")
  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz(3)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)

  @@unique([tenantId, entityType, legacyId])
  @@unique([tenantId, entityType, modernId])
  @@index([entityType, legacyId])
  @@map("legacy_entity_mapping")
}
